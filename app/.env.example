# Copy to .env and fill in. Never commit .env.
# Get these from the Supabase dashboard: Project Settings -> API Keys.
# The publishable key (sb_publishable_...) or legacy anon key both work;
# both are public by design and ship in the frontend bundle.

VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Helius devnet RPC key (Helius dashboard -> API Keys).
# Falls back to the public devnet endpoint when unset.
VITE_HELIUS_API_KEY=your-helius-api-key
